<UserControl x:Class="SonicRacingSaveManager.Features.Updates.Views.ManualUpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="420">

    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <materialDesign:PackIcon Kind="DownloadCircleOutline"
                                   Width="30"
                                   Height="30"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Manual Update"
                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                <TextBlock Text="Force-download the latest release from GitHub"
                         Style="{StaticResource MaterialDesignCaptionTextBlock}"
                         Opacity="0.7"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{DynamicResource MaterialDesignDivider}"
              CornerRadius="8"
              Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                       Width="26"
                                       Height="26"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CloudCheckOutline"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckFailed}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}"
                             FontWeight="Bold"
                             FontSize="14"
                             TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}"
                             Opacity="0.7"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Margin="0,16,0,0">
            <TextBlock Text="{Binding DownloadProgressText}"
                     Style="{StaticResource MaterialDesignBody2TextBlock}"
                     Margin="0,0,0,8"/>
            <ProgressBar Value="{Binding DownloadProgress}"
                       Height="8"
                       Maximum="100"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,22,0,0">
            <Button Content="Close"
                  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                  Style="{StaticResource MaterialDesignFlatButton}"
                  Height="36"
                  Margin="0,0,8,0"
                  Padding="14,0"/>

            <Button Content="Open in Browser"
                  Command="{Binding OpenBrowserCommand}"
                  Style="{StaticResource MaterialDesignOutlinedButton}"
                  Height="36"
                  Margin="0,0,8,0"
                  Padding="14,0"/>

            <Button Command="{Binding DownloadCommand}"
                  Style="{StaticResource MaterialDesignRaisedButton}"
                  Height="36"
                  Padding="16,0"
                  Background="#4CAF50">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download"
                                               Width="18"
                                               Height="18"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Download &amp; Install" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
