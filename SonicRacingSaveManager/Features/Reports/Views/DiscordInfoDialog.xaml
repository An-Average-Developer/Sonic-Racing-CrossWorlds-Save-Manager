<Window x:Class="SonicRacingSaveManager.Features.Reports.Views.DiscordInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Why Discord?"
        Height="440"
        Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        ResizeMode="NoResize"
        WindowStyle="None">

    <materialDesign:Card UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <materialDesign:ColorZone Grid.Row="0"
                                     Mode="PrimaryMid"
                                     Padding="16"
                                     materialDesign:ElevationAssist.Elevation="Dp4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Resources/Logos/Discord.png"
                          Width="28" Height="28"
                          Margin="0,0,10,0"/>
                    <TextBlock Text="Why connect with Discord?"
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:ColorZone>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="24,18,24,10">
                <TextBlock TextWrapping="Wrap"
                         Style="{StaticResource MaterialDesignBody1TextBlock}"
                         Margin="0,0,0,16">
                    Connecting lets us know
                    <Run Text=" who sent each report" FontWeight="Bold"/>, so we can follow up with you if we need
                    more details, and give you credit when your report leads to a fix.
                </TextBlock>

                <Border Background="{DynamicResource MaterialDesignDivider}"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="CheckDecagram"
                                                   Foreground="#00C853"
                                                   Width="18" Height="18"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="identify" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12">
                            This is the only permission requested. It gives us your Discord username and user ID — that's it.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,0,0,10">
                    We never see your email address, messages, friends list, or servers, and we never post or change
                    anything on your account.
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12">
                    This uses the same official "Sonic Racing CrossWorlds Save Manager" Discord application as the
                    Rich Presence feature. Your username is cached locally so you only need to connect once.
                </TextBlock>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource MaterialDesignDivider}" CornerRadius="0,0,8,8">
                <Button Content="GOT IT"
                      Click="CloseButton_Click"
                      Style="{StaticResource MaterialDesignFlatButton}"
                      HorizontalAlignment="Right"
                      Margin="10"
                      Height="36" MinWidth="100"/>
            </Border>
        </Grid>
    </materialDesign:Card>
</Window>
