<UserControl x:Class="SonicRacingSaveManager.Features.Steam.Views.SteamTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SonicRacingSaveManager">

    <UserControl.Resources>
        <!-- Self-contained style (doesn't depend on the app's MaterialDesign resources) for the
             Add-to-Steam confirmation overlay below, so it renders identically even if this
             control is ever hosted outside the main window's resource scope. -->
        <Style x:Key="SteamOverlayButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(local:ButtonHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Steam"
                                       Width="32" Height="32"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <StackPanel>
                    <TextBlock Text="Add to Steam"
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    <TextBlock Text="Add this app to your Steam library as a non-Steam game, with its own icon and artwork."
                             Style="{StaticResource MaterialDesignBody2TextBlock}"
                             Opacity="0.7"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource CardStyle}" Margin="10">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,10,10,16" MaxWidth="640">

                        <!-- Banner preview -->
                        <Border CornerRadius="8"
                              ClipToBounds="True"
                              Margin="0,0,0,12">
                            <Image x:Name="BannerImage"
                                  Stretch="UniformToFill"
                                  MaxHeight="180"/>
                        </Border>

                        <!-- Icon preview -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="48" Height="48"
                                  CornerRadius="6"
                                  ClipToBounds="True"
                                  BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                  BorderThickness="1">
                                <Image x:Name="IconImage" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Sonic Racing CrossWorlds Save Manager"
                                         FontWeight="Medium"
                                         FontSize="13"/>
                                <TextBlock Text="Shortcut icon &amp; library artwork preview"
                                         FontSize="11"
                                         Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Status -->
                        <Border Background="{DynamicResource MaterialDesignDivider}"
                              CornerRadius="6"
                              Padding="12,10"
                              Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon x:Name="StatusIcon"
                                                       Kind="InformationOutline"
                                                       Width="20" Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                <TextBlock x:Name="StatusText"
                                         TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.85"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="This adds a shortcut pointing at this app's own executable, along with a custom icon and library artwork (banner, capsule, poster, logo). If Steam is running, it will be closed and reopened to apply the changes."
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,18"/>

                        <!-- Add to Steam -->
                        <Button x:Name="AddToSteamBtn"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              HorizontalAlignment="Left"
                              Height="40"
                              Background="#1B2838"
                              Click="AddToSteamBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Steam" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Add to Steam" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── ADD TO STEAM OVERLAY ── -->
                <Grid x:Name="AddToSteamOverlay"
                      Visibility="Collapsed"
                      Background="#BB000000"
                      Panel.ZIndex="1000">
                    <Border Width="460" Background="#09141E"
                            BorderBrush="#153048" BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AddToSteamPopupScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="52"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#060F18"
                                    BorderBrush="#0D2030" BorderThickness="0,0,0,1">
                                <TextBlock Text="[ ADD TO STEAM ]"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="24,20,24,20" HorizontalAlignment="Center">
                                <TextBlock Text="Icon:"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="10" FontWeight="Bold" Foreground="#8AAABB"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="AddToSteamIconDefaultBtn" Width="52" Height="52"
                                            Style="{StaticResource SteamOverlayButtonStyle}"
                                            local:ButtonHelper.CornerRadius="4"
                                            Background="#0A1825" BorderBrush="#00B482" BorderThickness="2"
                                            Padding="4"
                                            IsHitTestVisible="False">
                                        <Image x:Name="AddToSteamIconDefaultImg" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="AddToSteamWarningText"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="10" FontWeight="Bold" Foreground="#E8A000"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#060F18"
                                    BorderBrush="#0D2030" BorderThickness="0,1,0,0">
                                <Grid Margin="14,0">
                                    <Button x:Name="AddToSteamCancelBtn"
                                            Height="36" MinWidth="110"
                                            Style="{StaticResource SteamOverlayButtonStyle}"
                                            local:ButtonHelper.CornerRadius="3"
                                            Background="#1A0606" BorderBrush="#440000" BorderThickness="1"
                                            Padding="16,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Click="AddToSteamCancelBtn_Click">
                                        <TextBlock Text="Cancel"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#CC3333"/>
                                    </Button>
                                    <Button x:Name="AddToSteamConfirmBtn"
                                            Height="36" MinWidth="150"
                                            Style="{StaticResource SteamOverlayButtonStyle}"
                                            local:ButtonHelper.CornerRadius="3"
                                            Background="#00503C" BorderBrush="#00B482" BorderThickness="1"
                                            Padding="16,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="AddToSteamConfirmBtn_Click">
                                        <TextBlock Text="ADD TO STEAM"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#00CCAA"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
